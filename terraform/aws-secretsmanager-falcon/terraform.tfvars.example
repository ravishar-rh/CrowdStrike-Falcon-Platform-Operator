aws_region = "us-east-1"
secret_name = "crowdstrike/falcon-operator"

# Prefer TF_VAR_* env vars or a private *.auto.tfvars that is gitignored:
#   export TF_VAR_falcon_client_id='...'
#   export TF_VAR_falcon_client_secret='...'
#   export TF_VAR_falcon_cid='...'
#   export TF_VAR_falcon_provisioning_token=''

# falcon_client_id          = "REPLACE_ME"
# falcon_client_secret      = "REPLACE_ME"
# falcon_cid                = "REPLACE_ME"
# falcon_provisioning_token = ""

tags = {
  Environment = "prod"
  Owner       = "platform"
}
